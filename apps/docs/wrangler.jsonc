{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Static assets only (no Worker script). Built and deployed by scripts/cloudflare/deploy.ts,
	// which also writes .vitepress/dist/_headers.
	"name": "human-flare-docs",
	"compatibility_date": "2026-11-04",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./.vitepress/dist",
		// VitePress `cleanUrls: true` links to /guide/foo; auto-trailing-slash serves foo.html for it
		// (the CloudFront Function in the AWS setup did this rewrite by hand).
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
	},
}
