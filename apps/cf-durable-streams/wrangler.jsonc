{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "humanlayer-streams",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Not publicly reachable: only service bindings (humanlayer-api, humanlayer-sync) call it.
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [{ "name": "STREAMS", "class_name": "DurableStreamObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DurableStreamObject"] }],
	"vars": {
		"LONG_POLL_TIMEOUT_MS": "30000",
		"SSE_MAX_DURATION_MS": "60000",
		"SSE_KEEPALIVE_MS": "15000",
		"MAX_APPEND_BYTES": "16777216",
		"MAX_STREAM_BYTES": "104857600"
	},
	"observability": { "enabled": true },
	// No secrets: only reachable through service bindings.
	"secrets": { "required": [] }
}
