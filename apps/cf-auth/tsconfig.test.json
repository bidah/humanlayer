{
	"compilerOptions": {
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"target": "ES2022",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true
	},
	"include": ["test", "scripts", "vitest.config.ts"]
}
