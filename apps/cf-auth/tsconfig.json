{
	"compilerOptions": {
		"lib": ["ES2023"],
		"types": ["@cloudflare/workers-types"],
		"target": "ES2022",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src"]
}
