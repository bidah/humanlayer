# HumanLayer on Cloudflare: deployment settings and secrets.
#
# Copy to .env.cloudflare (gitignored; keep it mode 0600) and fill in the REQUIRED section.
# Everything else is optional, has a default, or is written by `bun run cloudflare:deploy`:
# the deploy script creates the Cloudflare resources and appends their ids, and generates every
# missing secret, appending it here. It never replaces a value that is already set.
#
# Format: KEY=value or KEY='value' (single quotes are literal; double quotes expand \n).
# Every value below is a placeholder. See CLOUDFLARE.md for the full reference.

# ---------------------------------------------------------------------------------------------
# REQUIRED

# Cloudflare account id (dashboard > Workers & Pages > Account details).
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# Your workers.dev subdomain: Workers are served at https://<worker>.<WORKERS_SUBDOMAIN>.workers.dev.
WORKERS_SUBDOMAIN=your-subdomain
# Direct (non-pooled) Postgres 18 URL with logical replication enabled (wal_level=logical).
# Used by Electric (replication), Hyperdrive, and the migrations.
DATABASE_URL=postgresql://user:password@host.example.com:5432/humanlayer?sslmode=require

# ---------------------------------------------------------------------------------------------
# RESOURCE IDS (written by the deploy script; set them only to reuse existing resources)

# Hyperdrive config `humanlayer-db` (points at DATABASE_URL).
# HYPERDRIVE_ID=0123456789abcdef0123456789abcdef
# KV namespace `humanlayer-billing-cache`.
# BILLING_KV_ID=0123456789abcdef0123456789abcdef
# D1 database `humanlayer-auth`.
# AUTH_D1_DATABASE_ID=01234567-89ab-cdef-0123-456789abcdef

# ---------------------------------------------------------------------------------------------
# GENERATED SECRETS (generated by the deploy script when missing; never rotated by it)

# RS256 key pair (base64-encoded PEM, PKCS#8 / SPKI) that signs and verifies daemon tokens.
# RIPTIDE_DAEMON_TOKEN_PRIVATE_KEY=base64-pem
# RIPTIDE_DAEMON_TOKEN_PUBLIC_KEY=base64-pem
# Shared by humanlayer-electric and humanlayer-sync.
# ELECTRIC_SECRET=random-hex
# Bearer between Workers (api, jobs -> hosts; electric over workers.dev).
# INTERNAL_SERVICE_SECRET=random-hex
# HMAC key of the API's signed artifact URLs.
# ARTIFACT_URL_SIGNING_SECRET=random-hex
# humanlayer-auth: management API key (also the API's WORKOS_API_KEY), RS256 signing key (a JWK
# JSON object with "kid", single-quoted), and the webhook signing secret.
# HUMANLAYER_AUTH_API_KEY=sk_hl_random
# HUMANLAYER_AUTH_SIGNING_KEY_JWK='{"kty":"RSA","kid":"hl_...",...}'
# HUMANLAYER_AUTH_WEBHOOK_SECRET=random
# Optional, during a signing key rotation: the previous JWK, still published in the JWKS.
# HUMANLAYER_AUTH_SIGNING_KEY_JWK_PREVIOUS='{"kty":"RSA","kid":"hl_old",...}'

# ---------------------------------------------------------------------------------------------
# ORIGIN OVERRIDES (default: https://humanlayer-<name>.<WORKERS_SUBDOMAIN>.workers.dev)
# Set one when you put that Worker on a custom domain.

# API_ORIGIN=https://api.example.com
# SYNC_ORIGIN=https://sync.example.com
# APP_ORIGIN=https://app.example.com
# CLOUD_ORIGIN=https://cloud.example.com
# DOCS_ORIGIN=https://docs.example.com
# AUTH_ORIGIN=https://auth.example.com
# HOSTS_ORIGIN=https://hosts.example.com

# ---------------------------------------------------------------------------------------------
# AUTH (default: the humanlayer-auth Worker of this stack). Set these to use real WorkOS instead.

# WORKOS_API_HOSTNAME=api.workos.com
# WORKOS_CLIENT_ID=client_0123456789
# WORKOS_API_KEY=sk_live_placeholder
# WORKOS_WEBHOOK_SECRET=placeholder
# WORKOS_REDIRECT_URI=https://app.example.com
# Only for a local, plain-http auth service:
# WORKOS_API_HTTPS=false
# WORKOS_API_PORT=8787

# humanlayer-auth settings: self sign-up without an invitation (comma-separated; closed by
# default), extra redirect URIs (space-separated), and a webhook target for membership events
# (for example <API_ORIGIN>/webhooks/workos).
# AUTH_SIGNUP_ALLOWED_EMAILS=you@example.com
# AUTH_SIGNUP_ALLOWED_DOMAINS=example.com
# AUTH_EXTRA_REDIRECT_URIS=https://staging.example.com/*
# AUTH_WEBHOOK_URL=https://api.example.com/webhooks/workos

# ---------------------------------------------------------------------------------------------
# SETTINGS

# Cloudflare region the API Worker runs in; pick the one closest to your Postgres primary.
# PLACEMENT_REGION=aws:us-east-1
# Billing enforcement (needs Stripe below); also baked into the web apps.
# IS_BILLING_ENFORCEMENT_ENABLED=false
# CLI platforms the deploy publishes for `<HOSTS_ORIGIN>/cli/latest/humanlayer-<platform>`
# (comma-separated, or `all`). linux-x64 is always included: cloud hosts install it.
# CLI_TARGETS=linux-x64,linux-arm64,darwin-arm64,darwin-x64

# ---------------------------------------------------------------------------------------------
# CLOUD HOST PROVIDERS (Cloudflare Containers needs no key; each key below enables a provider)

# DAYTONA_API_KEY=dtn_placeholder
# DAYTONA_API_URL=https://app.daytona.io/api
# E2B_API_KEY=e2b_placeholder
# E2B_TEMPLATE=base

# ---------------------------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS (uploaded to humanlayer-api when set; skipped when absent)

# Stripe (billing)
# STRIPE_SECRET_KEY=sk_live_placeholder
# STRIPE_WEBHOOK_SECRET=whsec_placeholder
# STRIPE_PRICE_STARTER=price_placeholder
# STRIPE_PRICE_PRO=price_placeholder
# STRIPE_PRICE_ENTERPRISE=price_placeholder
# Resend (email)
# RESEND_API_KEY=re_placeholder
# RESEND_WEBHOOK_SECRET=whsec_placeholder
# RESEND_FROM_EMAIL='HumanLayer <noreply@example.com>'
# RESEND_PRODUCT_USERS_SEGMENT_ID=placeholder
# GitHub App
# GITHUB_APP_ID=123456
# GITHUB_APP_CLIENT_ID=Iv1.placeholder
# GITHUB_APP_SLUG=your-app
# GITHUB_APP_PRIVATE_KEY=base64-pem
# GITHUB_APP_WEBHOOK_SECRET=placeholder
# Slack
# SLACK_APP_ID=A0000000000
# SLACK_CLIENT_ID=0000000000.0000000000
# SLACK_CLIENT_SECRET=placeholder
# SLACK_SIGNING_SECRET=placeholder
# SLACK_OAUTH_REDIRECT_URL=https://api.example.com/...
# Jira and Linear OAuth
# JIRA_CLIENT_ID=placeholder
# JIRA_CLIENT_SECRET=placeholder
# JIRA_OAUTH_REDIRECT_URL=https://api.example.com/...
# LINEAR_CLIENT_ID=placeholder
# LINEAR_CLIENT_SECRET=placeholder
# LINEAR_OAUTH_REDIRECT_URL=https://api.example.com/...
# AI providers used by the API's background jobs (titles, summaries, research)
# ANTHROPIC_API_KEY=sk-ant-placeholder
# OPENAI_API_KEY=sk-placeholder
# EXA_API_KEY=placeholder
# CONTEXT7_API_KEY=placeholder
# Sentry (a no-op on Workers; accepted for parity) and PostHog
# SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
# POSTHOG_API_KEY=phc_placeholder
# POSTHOG_HOST=https://us.i.posthog.com
# Browser analytics baked into the web apps
# VITE_PUBLIC_POSTHOG_KEY=phc_placeholder
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# VITE_PUBLIC_SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
